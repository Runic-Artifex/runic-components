{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "runic-shell",
	"title": "Runic Shell",
	"type": "registry:block",
	"description": "Svelte 5 application chrome for frameless Runic WebViews.",
	"dependencies": [
		"@lucide/svelte@1.54.0",
		"clsx",
		"tailwind-merge"
	],
	"files": [
		{
			"content": "import { clsx, type ClassValue } from \"clsx\";\nimport { twMerge } from \"tailwind-merge\";\nexport function cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n",
			"type": "registry:component",
			"target": "runic/utils.ts"
		},
		{
			"content": "import { createContext } from \"svelte\";\nexport type WindowPlatform = \"windows\" | \"macos\" | \"linux\";\nexport interface WindowState {\n  maximized: boolean;\n  focused: boolean;\n}\nexport interface WindowHost {\n  state: WindowState;\n  capabilities: {\n    minimize: boolean;\n    maximize: boolean;\n    close: boolean;\n    move: boolean;\n  };\n  minimize(): void | Promise<void>;\n  toggleMaximize(): void | Promise<void>;\n  close(): void | Promise<void>;\n  startDragging?(): void | Promise<void>;\n}\nexport interface WindowContext {\n  readonly host: WindowHost;\n  readonly onError: (error: unknown) => void;\n}\nconst [getContext, setContext] = createContext<WindowContext>();\nexport const setWindowHostContext = setContext;\nexport function useWindowHost() {\n  try {\n    return getContext();\n  } catch {\n    throw new Error(\"Wrap window components in WindowHostProvider.\");\n  }\n}\nexport function useWindowAction() {\n  const context = useWindowHost();\n  return (action: () => void | Promise<void>) => {\n    try {\n      Promise.resolve(action()).catch((error) => context.onError(error));\n    } catch (error) {\n      context.onError(error);\n    }\n  };\n}\n",
			"type": "registry:component",
			"target": "runic/window-host.ts"
		},
		{
			"content": "<script lang=\"ts\">\n  import type { Snippet } from \"svelte\";\n  import { setWindowHostContext, type WindowHost } from \"./window-host\";\n  let {\n    host,\n    onError,\n    children,\n  }: {\n    host: WindowHost;\n    onError: (error: unknown) => void;\n    children: Snippet;\n  } = $props();\n  setWindowHostContext({\n    get host() {\n      return host;\n    },\n    get onError() {\n      return onError;\n    },\n  });\n</script>\n\n{@render children()}\n",
			"type": "registry:component",
			"target": "runic/WindowHostProvider.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { Minus, Square, Copy, X } from \"@lucide/svelte\";\n  import { cn } from \"./utils\";\n  import {\n    useWindowHost,\n    useWindowAction,\n    type WindowPlatform,\n  } from \"./window-host\";\n  let {\n    platform = \"windows\",\n    class: className,\n  }: { platform?: WindowPlatform; class?: string } = $props();\n  const context = useWindowHost();\n  const run = useWindowAction();\n  const host = $derived(context.host);\n  const mac = $derived(platform === \"macos\");\n  const controls = $derived([\n    {\n      name: \"Minimize window\",\n      icon: Minus,\n      action: () => host.minimize(),\n      enabled: host.capabilities.minimize,\n      color: \"bg-amber-400\",\n    },\n    {\n      name: host.state.maximized ? \"Restore window\" : \"Maximize window\",\n      icon: host.state.maximized ? Copy : Square,\n      action: () => host.toggleMaximize(),\n      enabled: host.capabilities.maximize,\n      color: \"bg-green-500\",\n    },\n    {\n      name: \"Close window\",\n      icon: X,\n      action: () => host.close(),\n      enabled: host.capabilities.close,\n      color: \"bg-red-400\",\n    },\n  ]);\n  const ordered = $derived(\n    mac ? [controls[2], controls[0], controls[1]] : controls,\n  );\n</script>\n\n<div\n  data-runic-no-drag\n  style:--webui-app-region=\"no-drag\"\n  class={cn(\"flex shrink-0 items-center\", mac && \"gap-2 px-4\", className)}\n>\n  {#each ordered as control (control.name)}\n    <button\n      type=\"button\"\n      aria-label={control.name}\n      title={control.name}\n      disabled={!control.enabled}\n      onclick={() => run(control.action)}\n      class={cn(\n        \"group grid place-items-center outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-30 disabled:pointer-events-none\",\n        mac\n          ? cn(\n              \"size-3.5 rounded-full\",\n              control.color,\n              !host.state.focused && \"!bg-muted-foreground\",\n            )\n          : \"h-11 w-11 text-muted-foreground hover:bg-accent\",\n        !mac &&\n          control.name === \"Close window\" &&\n          \"hover:bg-red-600 hover:text-white\",\n      )}\n    >\n      <control.icon\n        aria-hidden=\"true\"\n        class={cn(\n          mac\n            ? \"size-2.5 text-black opacity-0 group-hover:opacity-70 group-focus-visible:opacity-70\"\n            : \"size-3.5\",\n        )}\n      />\n    </button>\n  {/each}\n</div>\n",
			"type": "registry:component",
			"target": "runic/WindowControls.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import type { Snippet } from \"svelte\";\n  import { cn } from \"./utils\";\n  import {\n    useWindowHost,\n    useWindowAction,\n    type WindowPlatform,\n  } from \"./window-host\";\n  import WindowControls from \"./WindowControls.svelte\";\n  let {\n    title,\n    icon,\n    actions,\n    platform = \"windows\",\n    class: className,\n  }: {\n    title: string;\n    icon?: Snippet;\n    actions?: Snippet;\n    platform?: WindowPlatform;\n    class?: string;\n  } = $props();\n  const context = useWindowHost();\n  const host = $derived(context.host);\n  const run = useWindowAction();\n  function drag(event: PointerEvent) {\n    if (\n      event.button === 0 &&\n      event.detail !== 2 &&\n      host.capabilities.move &&\n      host.startDragging\n    )\n      run(() => host.startDragging!());\n  }\n  function maximize() {\n    if (host.capabilities.maximize) run(() => host.toggleMaximize());\n  }\n</script>\n\n<header\n  class={cn(\n    \"flex h-11 shrink-0 select-none items-center border-b border-border bg-muted/30\",\n    !host.state.focused && \"opacity-65\",\n    className,\n  )}\n>\n  {#if platform === \"macos\"}<WindowControls {platform} />{/if}\n  <!-- Dragging is a pointer-only native gesture; accessible window commands are adjacent buttons. -->\n  <!-- svelte-ignore a11y_no_static_element_interactions -->\n  <div\n    data-runic-drag-region\n    style:--webui-app-region={host.capabilities.move ? \"drag\" : \"no-drag\"}\n    style:touch-action=\"none\"\n    class=\"flex h-full min-w-0 flex-1 items-center gap-2.5 px-4 text-xs text-muted-foreground\"\n    onpointerdown={drag}\n    ondblclick={maximize}\n  >\n    {@render icon?.()}<span class=\"truncate\">{title}</span>\n  </div>\n  {#if actions}<div\n      data-runic-no-drag\n      style:--webui-app-region=\"no-drag\"\n      class=\"flex items-center gap-1 px-2\"\n    >\n      {@render actions()}\n    </div>{/if}\n  {#if platform !== \"macos\"}<WindowControls {platform} />{/if}\n</header>\n",
			"type": "registry:component",
			"target": "runic/TitleBar.svelte"
		},
		{
			"content": "<script module lang=\"ts\">\n  import type { Snippet } from \"svelte\";\n  export interface DocumentTab {\n    id: string;\n    title: string;\n    dirty?: boolean;\n    icon?: Snippet;\n  }\n</script>\n\n<script lang=\"ts\">\n  import { tick } from \"svelte\";\n  import { X, Plus } from \"@lucide/svelte\";\n  import { cn } from \"./utils\";\n  let {\n    tabs,\n    value,\n    onValueChange,\n    onClose,\n    onAdd,\n    children,\n    class: className,\n  }: {\n    tabs: DocumentTab[];\n    value: string;\n    onValueChange: (id: string) => void;\n    onClose?: (id: string) => void;\n    onAdd?: () => void;\n    children: Snippet;\n    class?: string;\n  } = $props();\n  const prefix = $props.id();\n  const tabId = (id: string) => `${prefix}-tab-${id}`;\n  const panelId = `${prefix}-panel`;\n  async function select(index: number) {\n    const tab = tabs[index];\n    if (tab) {\n      onValueChange(tab.id);\n      await tick();\n      document.getElementById(tabId(tab.id))?.focus();\n    }\n  }\n  function keydown(event: KeyboardEvent, index: number, id: string) {\n    const next =\n      event.key === \"ArrowRight\"\n        ? (index + 1) % tabs.length\n        : event.key === \"ArrowLeft\"\n          ? (index - 1 + tabs.length) % tabs.length\n          : event.key === \"Home\"\n            ? 0\n            : event.key === \"End\"\n              ? tabs.length - 1\n              : null;\n    if (next !== null) {\n      event.preventDefault();\n      void select(next);\n    }\n    if (event.key === \"Delete\" && onClose) {\n      event.preventDefault();\n      onClose(id);\n    }\n  }\n</script>\n\n<div class={cn(\"flex min-h-0 flex-1 flex-col\", className)}>\n  <div class=\"flex shrink-0 items-center border-b border-border bg-muted/20\">\n    <div\n      role=\"tablist\"\n      aria-label=\"Open documents\"\n      class=\"flex min-w-0 flex-1 overflow-x-auto\"\n    >\n      {#each tabs as tab, index (tab.id)}\n        <div\n          class={cn(\n            \"relative flex shrink-0 items-center border-r border-border\",\n            value === tab.id &&\n              \"bg-background after:absolute after:inset-x-0 after:top-0 after:h-0.5 after:bg-primary\",\n          )}\n        >\n          <button\n            type=\"button\"\n            role=\"tab\"\n            id={tabId(tab.id)}\n            aria-controls={panelId}\n            aria-selected={value === tab.id}\n            tabindex={value === tab.id ? 0 : -1}\n            class=\"flex h-10 items-center gap-2 pl-4 pr-2 text-xs outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring\"\n            onclick={() => onValueChange(tab.id)}\n            onkeydown={(event) => keydown(event, index, tab.id)}\n          >\n            {@render tab.icon?.()}<span>{tab.title}</span>\n            {#if tab.dirty}<span\n                class=\"size-1.5 rounded-full bg-primary\"\n                aria-label=\"Unsaved changes\"\n              ></span>{/if}\n          </button>\n          {#if onClose}<button\n              type=\"button\"\n              aria-label={`Close ${tab.title}`}\n              onclick={() => onClose?.(tab.id)}\n              class=\"mr-2 grid size-6 place-items-center rounded text-muted-foreground hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring\"\n              ><X aria-hidden=\"true\" class=\"size-3\" /></button\n            >{/if}\n        </div>\n      {/each}\n    </div>\n    {#if onAdd}<button\n        type=\"button\"\n        aria-label=\"New document\"\n        onclick={onAdd}\n        class=\"m-1 grid size-8 shrink-0 place-items-center rounded text-muted-foreground hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring\"\n        ><Plus aria-hidden=\"true\" class=\"size-4\" /></button\n      >{/if}\n  </div>\n  <div\n    role=\"tabpanel\"\n    id={panelId}\n    aria-labelledby={tabs.some((tab) => tab.id === value)\n      ? tabId(value)\n      : undefined}\n    aria-label={tabs.length ? undefined : \"No open documents\"}\n    tabindex=\"0\"\n    class=\"min-h-0 flex-1 overflow-auto outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring\"\n  >\n    {@render children()}\n  </div>\n</div>\n",
			"type": "registry:component",
			"target": "runic/DocumentTabs.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import type { Snippet } from \"svelte\";\n  import { cn } from \"./utils\";\n  let {\n    sidebar,\n    children,\n    sidebarLabel = \"Sidebar width\",\n    defaultWidth = 220,\n    minWidth = 160,\n    maxWidth = 360,\n    collapsed = false,\n    class: className,\n  }: {\n    sidebar: Snippet;\n    children: Snippet;\n    sidebarLabel?: string;\n    defaultWidth?: number;\n    minWidth?: number;\n    maxWidth?: number;\n    collapsed?: boolean;\n    class?: string;\n  } = $props();\n  const clamp = (n: number) => Math.min(maxWidth, Math.max(minWidth, n));\n  // Initial width uses the initial default; live bounds are applied below.\n  // svelte-ignore state_referenced_locally\n  let width = $state(clamp(defaultWidth));\n  const boundedWidth = $derived(clamp(width));\n  let start: { x: number; width: number } | undefined;\n  function down(event: PointerEvent) {\n    if (event.button !== 0) return;\n    (event.currentTarget as HTMLDivElement).setPointerCapture(event.pointerId);\n    start = { x: event.clientX, width: boundedWidth };\n  }\n  function up(event: PointerEvent) {\n    start = undefined;\n    const target = event.currentTarget as HTMLDivElement;\n    if (target.hasPointerCapture(event.pointerId))\n      target.releasePointerCapture(event.pointerId);\n  }\n  function keydown(event: KeyboardEvent) {\n    if ([\"ArrowLeft\", \"ArrowRight\", \"Home\", \"End\"].includes(event.key)) {\n      event.preventDefault();\n      width =\n        event.key === \"Home\"\n          ? minWidth\n          : event.key === \"End\"\n            ? maxWidth\n            : clamp(\n                boundedWidth +\n                  (event.key === \"ArrowRight\" ? 1 : -1) *\n                    (event.shiftKey ? 32 : 8),\n              );\n    }\n  }\n</script>\n\n<div class={cn(\"flex min-h-0 flex-1 overflow-hidden\", className)}>\n  {#if !collapsed}\n    <aside\n      style:width={`${boundedWidth}px`}\n      class=\"shrink-0 overflow-auto bg-muted/15\"\n    >\n      {@render sidebar()}\n    </aside>\n    <!-- A focusable separator exposes the adjustable width and supports keyboard resizing. -->\n    <!-- svelte-ignore a11y_no_noninteractive_tabindex -->\n    <!-- svelte-ignore a11y_no_noninteractive_element_interactions -->\n    <div\n      role=\"separator\"\n      aria-label={sidebarLabel}\n      aria-orientation=\"vertical\"\n      aria-valuemin={minWidth}\n      aria-valuemax={maxWidth}\n      aria-valuenow={boundedWidth}\n      tabindex=\"0\"\n      class=\"relative z-10 w-1 shrink-0 cursor-col-resize touch-none bg-border outline-none before:absolute before:inset-y-0 before:-left-1 before:w-3 hover:bg-primary focus-visible:bg-primary\"\n      onpointerdown={down}\n      onpointermove={(event) => {\n        if (start) width = clamp(start.width + event.clientX - start.x);\n      }}\n      onpointerup={up}\n      onpointercancel={() => {\n        start = undefined;\n      }}\n      onlostpointercapture={() => {\n        start = undefined;\n      }}\n      ondblclick={() => {\n        width = clamp(defaultWidth);\n      }}\n      onkeydown={keydown}\n    ></div>\n  {/if}\n  <div class=\"flex min-w-0 flex-1 flex-col\">{@render children()}</div>\n</div>\n",
			"type": "registry:component",
			"target": "runic/Workspace.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import type { Snippet } from \"svelte\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n  import { cn } from \"./utils\";\n  let {\n    class: className,\n    children,\n    ...props\n  }: HTMLAttributes<HTMLElement> & { children?: Snippet } = $props();\n</script>\n\n<footer\n  aria-label=\"Application status\"\n  class={cn(\n    \"flex h-8 shrink-0 items-center justify-between gap-3 border-t border-border bg-muted/30 px-3 text-[11px] text-muted-foreground\",\n    className,\n  )}\n  {...props}\n>\n  {@render children?.()}\n</footer>\n",
			"type": "registry:component",
			"target": "runic/StatusBar.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import type { Snippet } from \"svelte\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n  import { cn } from \"./utils\";\n  let {\n    class: className,\n    children,\n    ...props\n  }: HTMLAttributes<HTMLSpanElement> & { children?: Snippet } = $props();\n</script>\n\n<span class={cn(\"inline-flex items-center gap-1.5\", className)} {...props}\n  >{@render children?.()}</span\n>\n",
			"type": "registry:component",
			"target": "runic/StatusBarItem.svelte"
		},
		{
			"content": "import type { WindowHost, WindowState } from \"./window-host\";\n/** Structural subset of your application-generated Runic Views client. */\nexport interface RunicWindowCommands {\n  minimize(): Promise<unknown>;\n  toggleMaximized(): Promise<unknown>;\n  requestClose(): Promise<unknown>;\n}\nexport interface RunicWindowSnapshot extends WindowState {\n  canMinimize: boolean;\n  canToggleMaximized: boolean;\n  canRequestClose: boolean;\n  canMove: boolean;\n}\n/** Derive a new host from useView's current snapshot. useView owns its client. */\nexport function createRunicWindowHost(\n  client: RunicWindowCommands,\n  state: RunicWindowSnapshot,\n): WindowHost {\n  return {\n    state,\n    capabilities: {\n      minimize: state.canMinimize,\n      maximize: state.canToggleMaximized,\n      close: state.canRequestClose,\n      move: state.canMove,\n    },\n    minimize: async () => {\n      await client.minimize();\n    },\n    toggleMaximize: async () => {\n      await client.toggleMaximized();\n    },\n    close: async () => {\n      await client.requestClose();\n    },\n    // Runic Desktop's authenticated bootstrap owns --webui-app-region dragging.\n  };\n}\n",
			"type": "registry:component",
			"target": "runic/runic-window-host.ts"
		}
	]
}