{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "runic-shell",
  "title": "runic shell",
  "description": "Vue 3 application chrome for frameless Runic WebViews.",
  "dependencies": [
    "@lucide/vue@1.54.0",
    "clsx",
    "tailwind-merge"
  ],
  "files": [
    {
      "path": "src/components/runic/utils.ts",
      "content": "import { clsx, type ClassValue } from \"clsx\";\nimport { twMerge } from \"tailwind-merge\";\nexport function cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/runic/window-host.ts",
      "content": "import { inject, type InjectionKey } from \"vue\";\nexport type WindowPlatform = \"windows\" | \"macos\" | \"linux\";\nexport interface WindowState {\n  maximized: boolean;\n  focused: boolean;\n}\nexport interface WindowHost {\n  state: WindowState;\n  capabilities: {\n    minimize: boolean;\n    maximize: boolean;\n    close: boolean;\n    move: boolean;\n  };\n  minimize(): void | Promise<void>;\n  toggleMaximize(): void | Promise<void>;\n  close(): void | Promise<void>;\n  startDragging?(): void | Promise<void>;\n}\nexport interface WindowContext {\n  readonly host: WindowHost;\n  run(action: () => void | Promise<void>): void;\n}\nexport const windowContextKey: InjectionKey<WindowContext> =\n  Symbol(\"RunicWindowHost\");\nexport function useWindowContext() {\n  const value = inject(windowContextKey);\n  if (!value) throw new Error(\"Wrap window components in WindowHostProvider.\");\n  return value;\n}\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/runic/WindowHostProvider.vue",
      "content": "<script setup lang=\"ts\">\nimport { provide } from \"vue\";\nimport { windowContextKey, type WindowHost } from \"./window-host\";\nconst props = defineProps<{\n  host: WindowHost;\n  onError: (error: unknown) => void;\n}>();\nprovide(windowContextKey, {\n  get host() {\n    return props.host;\n  },\n  run(action) {\n    try {\n      Promise.resolve(action()).catch((error) => props.onError(error));\n    } catch (error) {\n      props.onError(error);\n    }\n  },\n});\n</script>\n<template><slot /></template>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/runic/WindowControls.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport { Minus, Square, Copy, X } from \"./icons\";\nimport { cn } from \"./utils\";\nimport { useWindowContext, type WindowPlatform } from \"./window-host\";\nconst props = withDefaults(defineProps<{ platform?: WindowPlatform }>(), {\n  platform: \"windows\",\n});\nconst context = useWindowContext();\nconst mac = computed(() => props.platform === \"macos\");\nconst controls = computed(() => {\n  const host = context.host;\n  const items = [\n    {\n      name: \"Minimize window\",\n      icon: Minus,\n      action: () => host.minimize(),\n      enabled: host.capabilities.minimize,\n      color: \"bg-amber-400\",\n    },\n    {\n      name: host.state.maximized ? \"Restore window\" : \"Maximize window\",\n      icon: host.state.maximized ? Copy : Square,\n      action: () => host.toggleMaximize(),\n      enabled: host.capabilities.maximize,\n      color: \"bg-green-500\",\n    },\n    {\n      name: \"Close window\",\n      icon: X,\n      action: () => host.close(),\n      enabled: host.capabilities.close,\n      color: \"bg-red-400\",\n    },\n  ];\n  return mac.value ? [items[2], items[0], items[1]] : items;\n});\n</script>\n<template>\n  <div\n    data-runic-no-drag\n    style=\"--webui-app-region: no-drag\"\n    :class=\"cn('flex shrink-0 items-center', mac && 'gap-2 px-4')\"\n  >\n    <button\n      v-for=\"control in controls\"\n      :key=\"control.name\"\n      type=\"button\"\n      :aria-label=\"control.name\"\n      :title=\"control.name\"\n      :disabled=\"!control.enabled\"\n      @click=\"context.run(control.action)\"\n      :class=\"\n        cn(\n          'group grid place-items-center outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-30 disabled:pointer-events-none',\n          mac\n            ? cn(\n                'size-3.5 rounded-full',\n                control.color,\n                !context.host.state.focused && '!bg-muted-foreground',\n              )\n            : 'h-11 w-11 text-muted-foreground hover:bg-accent',\n          !mac &&\n            control.name === 'Close window' &&\n            'hover:bg-red-600 hover:text-white',\n        )\n      \"\n    >\n      <component\n        :is=\"control.icon\"\n        aria-hidden=\"true\"\n        :class=\"\n          cn(\n            mac\n              ? 'size-2.5 text-black opacity-0 group-hover:opacity-70 group-focus-visible:opacity-70'\n              : 'size-3.5',\n          )\n        \"\n      />\n    </button>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/runic/TitleBar.vue",
      "content": "<script setup lang=\"ts\">\nimport { cn } from \"./utils\";\nimport { useWindowContext, type WindowPlatform } from \"./window-host\";\nimport WindowControls from \"./WindowControls.vue\";\nconst props = withDefaults(\n  defineProps<{ title?: string; platform?: WindowPlatform }>(),\n  { platform: \"windows\" },\n);\nconst context = useWindowContext();\nfunction drag(event: PointerEvent) {\n  if (\n    event.button === 0 &&\n    event.detail !== 2 &&\n    context.host.capabilities.move &&\n    context.host.startDragging\n  )\n    context.run(() => context.host.startDragging!());\n}\nfunction maximize() {\n  if (context.host.capabilities.maximize)\n    context.run(() => context.host.toggleMaximize());\n}\n</script>\n<template>\n  <header\n    :class=\"\n      cn(\n        'flex h-11 shrink-0 select-none items-center border-b border-border bg-muted/30',\n        !context.host.state.focused && 'opacity-65',\n      )\n    \"\n  >\n    <WindowControls\n      v-if=\"props.platform === 'macos'\"\n      :platform=\"props.platform\"\n    />\n    <div\n      data-runic-drag-region\n      :style=\"{\n        '--webui-app-region': context.host.capabilities.move\n          ? 'drag'\n          : 'no-drag',\n        touchAction: 'none',\n      }\"\n      class=\"flex h-full min-w-0 flex-1 items-center gap-2.5 px-4 text-xs text-muted-foreground\"\n      @pointerdown=\"drag\"\n      @dblclick=\"maximize\"\n    >\n      <slot name=\"icon\" /><span class=\"truncate\"\n        ><slot name=\"title\">{{ props.title }}</slot></span\n      >\n    </div>\n    <div\n      v-if=\"$slots.actions\"\n      data-runic-no-drag\n      style=\"--webui-app-region: no-drag\"\n      class=\"flex items-center gap-1 px-2\"\n    >\n      <slot name=\"actions\" />\n    </div>\n    <WindowControls\n      v-if=\"props.platform !== 'macos'\"\n      :platform=\"props.platform\"\n    />\n  </header>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/runic/document-tab.ts",
      "content": "import type { Component } from \"vue\";\nexport interface DocumentTab {\n  id: string;\n  title: string;\n  dirty?: boolean;\n  icon?: Component;\n}\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/runic/DocumentTabs.vue",
      "content": "<script setup lang=\"ts\">\nimport { useId, nextTick, type ComponentPublicInstance } from \"vue\";\nimport { X, Plus } from \"./icons\";\nimport type { DocumentTab } from \"./document-tab\";\nimport { cn } from \"./utils\";\nconst props = withDefaults(\n  defineProps<{\n    tabs: DocumentTab[];\n    modelValue: string;\n    closable?: boolean;\n    addable?: boolean;\n  }>(),\n  { closable: true, addable: false },\n);\nconst emit = defineEmits<{\n  \"update:modelValue\": [id: string];\n  close: [id: string];\n  add: [];\n}>();\nconst prefix = useId();\nconst tabId = (id: string) => prefix + \"-tab-\" + id;\nconst panelId = prefix + \"-panel\";\nconst refs = new Map<string, HTMLButtonElement>();\nfunction setRef(id: string, el: Element | ComponentPublicInstance | null) {\n  if (el instanceof HTMLButtonElement) refs.set(id, el);\n  else refs.delete(id);\n}\nasync function select(index: number) {\n  const tab = props.tabs[index];\n  if (tab) {\n    emit(\"update:modelValue\", tab.id);\n    await nextTick();\n    refs.get(tab.id)?.focus();\n  }\n}\nfunction keydown(event: KeyboardEvent, index: number) {\n  const next =\n    event.key === \"ArrowRight\"\n      ? (index + 1) % props.tabs.length\n      : event.key === \"ArrowLeft\"\n        ? (index - 1 + props.tabs.length) % props.tabs.length\n        : event.key === \"Home\"\n          ? 0\n          : event.key === \"End\"\n            ? props.tabs.length - 1\n            : null;\n  if (next !== null) {\n    event.preventDefault();\n    void select(next);\n  }\n  if (event.key === \"Delete\" && props.closable) {\n    event.preventDefault();\n    emit(\"close\", props.tabs[index].id);\n  }\n}\n</script>\n<template>\n  <div class=\"flex min-h-0 flex-1 flex-col\">\n    <div class=\"flex shrink-0 items-center border-b border-border bg-muted/20\">\n      <div\n        role=\"tablist\"\n        aria-label=\"Open documents\"\n        class=\"flex min-w-0 flex-1 overflow-x-auto\"\n      >\n        <div\n          v-for=\"(tab, index) in props.tabs\"\n          :key=\"tab.id\"\n          :class=\"\n            cn(\n              'relative flex shrink-0 items-center border-r border-border',\n              props.modelValue === tab.id &&\n                'bg-background after:absolute after:inset-x-0 after:top-0 after:h-0.5 after:bg-primary',\n            )\n          \"\n        >\n          <button\n            :ref=\"(el) => setRef(tab.id, el)\"\n            type=\"button\"\n            role=\"tab\"\n            :id=\"tabId(tab.id)\"\n            :aria-controls=\"panelId\"\n            :aria-selected=\"props.modelValue === tab.id\"\n            :tabindex=\"props.modelValue === tab.id ? 0 : -1\"\n            class=\"flex h-10 items-center gap-2 pl-4 pr-2 text-xs outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring\"\n            @click=\"emit('update:modelValue', tab.id)\"\n            @keydown=\"keydown($event, index)\"\n          >\n            <component\n              v-if=\"tab.icon\"\n              :is=\"tab.icon\"\n              aria-hidden=\"true\"\n              class=\"size-3\"\n            /><span>{{ tab.title }}</span\n            ><span\n              v-if=\"tab.dirty\"\n              class=\"size-1.5 rounded-full bg-primary\"\n              aria-label=\"Unsaved changes\"\n            /></button\n          ><button\n            v-if=\"props.closable\"\n            type=\"button\"\n            :aria-label=\"'Close ' + tab.title\"\n            @click=\"emit('close', tab.id)\"\n            class=\"mr-2 grid size-6 place-items-center rounded text-muted-foreground hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring\"\n          >\n            <X aria-hidden=\"true\" class=\"size-3\" />\n          </button>\n        </div>\n      </div>\n      <button\n        v-if=\"props.addable\"\n        type=\"button\"\n        aria-label=\"New document\"\n        @click=\"emit('add')\"\n        class=\"m-1 grid size-8 shrink-0 place-items-center rounded text-muted-foreground hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring\"\n      >\n        <Plus aria-hidden=\"true\" class=\"size-4\" />\n      </button>\n    </div>\n    <div\n      role=\"tabpanel\"\n      :id=\"panelId\"\n      :aria-labelledby=\"\n        props.tabs.some((t) => t.id === props.modelValue)\n          ? tabId(props.modelValue)\n          : undefined\n      \"\n      :aria-label=\"props.tabs.length ? undefined : 'No open documents'\"\n      tabindex=\"0\"\n      class=\"min-h-0 flex-1 overflow-auto outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring\"\n    >\n      <slot />\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/runic/Workspace.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref, computed } from \"vue\";\nconst props = withDefaults(\n  defineProps<{\n    sidebarLabel?: string;\n    defaultWidth?: number;\n    minWidth?: number;\n    maxWidth?: number;\n    collapsed?: boolean;\n  }>(),\n  {\n    sidebarLabel: \"Sidebar width\",\n    defaultWidth: 220,\n    minWidth: 160,\n    maxWidth: 360,\n    collapsed: false,\n  },\n);\nconst clamp = (n: number) =>\n  Math.min(props.maxWidth, Math.max(props.minWidth, n));\nconst width = ref(props.defaultWidth);\nconst actualWidth = computed(() => clamp(width.value));\nlet start: { x: number; width: number } | null = null;\nfunction down(event: PointerEvent) {\n  if (event.button !== 0) return;\n  (event.currentTarget as HTMLElement).setPointerCapture(event.pointerId);\n  start = { x: event.clientX, width: actualWidth.value };\n}\nfunction move(event: PointerEvent) {\n  if (start) width.value = clamp(start.width + event.clientX - start.x);\n}\nfunction up(event: PointerEvent) {\n  start = null;\n  const target = event.currentTarget as HTMLElement;\n  if (target.hasPointerCapture(event.pointerId))\n    target.releasePointerCapture(event.pointerId);\n}\nfunction keydown(event: KeyboardEvent) {\n  if ([\"ArrowLeft\", \"ArrowRight\", \"Home\", \"End\"].includes(event.key)) {\n    event.preventDefault();\n    width.value =\n      event.key === \"Home\"\n        ? props.minWidth\n        : event.key === \"End\"\n          ? props.maxWidth\n          : clamp(\n              actualWidth.value +\n                (event.key === \"ArrowRight\" ? 1 : -1) *\n                  (event.shiftKey ? 32 : 8),\n            );\n  }\n}\n</script>\n<template>\n  <div class=\"flex min-h-0 flex-1 overflow-hidden\">\n    <template v-if=\"!props.collapsed\"\n      ><aside\n        :style=\"{ width: actualWidth + 'px' }\"\n        class=\"shrink-0 overflow-auto bg-muted/15\"\n      >\n        <slot name=\"sidebar\" />\n      </aside>\n      <div\n        role=\"separator\"\n        :aria-label=\"props.sidebarLabel\"\n        aria-orientation=\"vertical\"\n        :aria-valuemin=\"props.minWidth\"\n        :aria-valuemax=\"props.maxWidth\"\n        :aria-valuenow=\"actualWidth\"\n        tabindex=\"0\"\n        class=\"relative z-10 w-1 shrink-0 cursor-col-resize touch-none bg-border outline-none before:absolute before:inset-y-0 before:-left-1 before:w-3 hover:bg-primary focus-visible:bg-primary\"\n        @pointerdown=\"down\"\n        @pointermove=\"move\"\n        @pointerup=\"up\"\n        @pointercancel=\"start = null\"\n        @lostpointercapture=\"start = null\"\n        @dblclick=\"width = props.defaultWidth\"\n        @keydown=\"keydown\"\n    /></template>\n    <div class=\"flex min-w-0 flex-1 flex-col\"><slot /></div>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/runic/StatusBar.vue",
      "content": "<template>\n  <footer\n    aria-label=\"Application status\"\n    class=\"flex h-8 shrink-0 items-center justify-between gap-3 border-t border-border bg-muted/30 px-3 text-[11px] text-muted-foreground\"\n  >\n    <slot />\n  </footer>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/runic/StatusBarItem.vue",
      "content": "<template>\n  <span class=\"inline-flex items-center gap-1.5\"><slot /></span>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/runic/runic-window-host.ts",
      "content": "import type { WindowHost, WindowState } from \"./window-host\";\n/** Structural subset of an application-generated Runic Views client. */\nexport interface RunicWindowCommands {\n  minimize(): Promise<unknown>;\n  toggleMaximized(): Promise<unknown>;\n  requestClose(): Promise<unknown>;\n}\nexport interface RunicWindowSnapshot extends WindowState {\n  canMinimize: boolean;\n  canToggleMaximized: boolean;\n  canRequestClose: boolean;\n  canMove: boolean;\n}\n/** Recreate from useView's current snapshot. Commands remain owned by useView. */\nexport function createRunicWindowHost(\n  client: RunicWindowCommands,\n  state: RunicWindowSnapshot,\n): WindowHost {\n  return {\n    state,\n    capabilities: {\n      minimize: state.canMinimize,\n      maximize: state.canToggleMaximized,\n      close: state.canRequestClose,\n      move: state.canMove,\n    },\n    minimize: async () => {\n      await client.minimize();\n    },\n    toggleMaximize: async () => {\n      await client.toggleMaximized();\n    },\n    close: async () => {\n      await client.requestClose();\n    },\n    // Runic Desktop's authenticated bootstrap owns --webui-app-region dragging.\n  };\n}\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/runic/icons.ts",
      "content": "export { Minus, Square, Copy, X, Plus } from \"@lucide/vue\";\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:block"
}
